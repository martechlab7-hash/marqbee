{
  "name": "marqbee",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "pnpm --filter @marqbee/db migrate"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
