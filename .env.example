# --- Database ---
# Supabase (Vercel integration): it sets POSTGRES_URL + POSTGRES_URL_NON_POOLING; just add DATABASE_APP_PASSWORD.
# Supabase (manual): DATABASE_URL=<transaction pooler URL, port 6543> + DATABASE_APP_PASSWORD.
# DATABASE_APP_PASSWORD=
# Local Postgres (see scripts/db-setup.sh):
# App role: subject to row-level security. Used by the dashboard API.
DATABASE_URL=postgres://marqbee_app:marqbee_app@localhost:5432/marqbee
# Service role: BYPASSRLS. Used only by webhook ingest, workers and migrations.
DATABASE_SERVICE_URL=postgres://marqbee_service:marqbee_service@localhost:5432/marqbee
REDIS_URL=redis://localhost:6379

# --- Meta / Instagram API with Instagram Login ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=change-me
META_GRAPH_VERSION=v23.0
# Set to "fake" in local dev/tests to log sends instead of calling Meta.
# META_CLIENT=fake

# --- Security ---
# 32-byte base64 key used for envelope encryption of access tokens (swap for KMS in prod).
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=change-me-to-a-long-random-string

# --- URLs ---
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
API_PORT=4000
